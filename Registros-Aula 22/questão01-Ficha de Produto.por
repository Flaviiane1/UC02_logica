programa {
  funcao inicio() {
    cadeia nome 
    real preco 
    inteiro quantidade 
    escreva("Digite o nome do produto: ")
    leia(nome)
    escreva("Digite o preço: ")
    leia(preco)
    escreva("Digite a quantidade: ")
    leia(quantidade)
    escreva("\n--- FICHA DO PRODUTO ---\n")
    escreva("Nome: ", nome, "\n")
    escreva("Preço: ", preco, "\n")
    escreva("Quantidade: ", quantidade, "\n")
  }
}
