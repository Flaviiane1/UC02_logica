programa {
    funcao inicio() {
        real saldo
        cadeia ativo
        escreva("Digite o valor do saldo do seu cartão de ônibus: ")
        leia(saldo)
        escreva("O cartão está ativo?: ")
        leia(ativo)
        se(saldo >= 2.00 e ativo == "sim") {

         } escreva("Acesso liberado!")
    }
    escreva("Acesso negado!")
}