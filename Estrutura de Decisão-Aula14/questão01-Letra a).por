programa {
  funcao inicio() {
    // Questão simples, pois possui apenas uma comparação
    // Declaração de variáveis
    real temperatura 
    // Entrada de dados
    escreva("Qual a temperatura atual?: ")
    leia(temperatura)
    // Processamento
    se(temperatura >= 33)
    // Saída de dados
    escreva("O sol está muito forte, leve protetor solar!")
    senao{
      escreva("Aproveite a praia!")
    }
    }
  }
}
